# ESP-IDF build output
build/
managed_components/
dependencies.lock

# Active config is machine-local; sdkconfig.defaults is the tracked source of truth.
sdkconfig
sdkconfig.old
sdkconfig.ci

# Never commit the flash dump — it contains WiFi credentials from NVS.
*.bin
!apps/**/*.bin

# Secrets: WiFi credentials, API keys for widgets during development.
secrets.h
secrets.json
*.local.json

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# agent/ — the Windows PC agent (.NET), build output and per-user IDE state.
# Its own config.json (token, port) lives in %LOCALAPPDATA%\DeskosAgent, not here.
agent/**/bin/
agent/**/obj/
*.csproj.user
