menu "deskos network"

    config DESKOS_WIFI_SSID
        string "WiFi SSID (build-time default)"
        default ""
        help
            Used only when NVS holds no credentials. Left empty by default.

            These land in sdkconfig, which is NOT tracked by git, so a password
            set here does not end up in the repository. It is still a build
            artifact on disk — prefer net_set_credentials() once a provisioning
            UI exists.

    config DESKOS_WIFI_PASSWORD
        string "WiFi password (build-time default)"
        default ""
        help
            See CONFIG_DESKOS_WIFI_SSID. Empty means an open network.

    config DESKOS_TZ
        string "POSIX timezone string"
        default "EET-2EEST,M3.5.0/3,M10.5.0/4"
        help
            Defaults to Europe/Sofia, matching the built-in weather widget's
            location. Change it if the device lives elsewhere.

            POSIX TZ counts offsets the opposite way round from what people
            expect: the "-2" above means UTC+2. Moscow (UTC+3) is "MSK-3",
            Berlin is "CET-1CEST,M3.5.0,M10.5.0/3", plain UTC is "UTC0".

    config DESKOS_SNTP_SERVER
        string "SNTP server"
        default "pool.ntp.org"

endmenu
